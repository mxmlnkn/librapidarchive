{
  "problemMatcher": [
    {
      "owner": "msvc-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(.+?)\\((\\d+)(?:,(\\d+))?\\):\\s+warning\\s+([A-Z]+\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "msvc-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+?)\\((\\d+)(?:,(\\d+))?\\):\\s+(?:error|fatal error)\\s+([A-Z]+\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
